[21.409, "o", "Starting: plan openvox_tune::tune\r\nStarting: task openvox_tune::host_resources on puppet, compiler01\r\nFinished: task openvox_tune::host_resources with 0 failures in 8.08 sec\r\n# puppet: 4 CPU(s), 7488 MB memory, 1872 MB reserved\r\n# Current: 3 instances (default), 2048m heap, JVM default code cache, 512 MB heap per instance\r\n# Server with compilers: the compilers compile the catalogs, so this server keeps 1 instance below 4 CPUs, 2 below 16 and 4 from 16.\r\njruby-puppet.max-active-instances: 2\r\nJAVA_ARGS: -Xms1536m -Xmx1536m -XX:ReservedCodeCacheSize=512m\r\n# compiler01: 8 CPU(s), 15351 MB memory, 3837 MB reserved\r\n# Current: 4 instances (default), 2048m heap, JVM default code cache, 384 MB heap per instance\r\n"]
[21.41, "o", "# Compiler: its CA service is disabled.\r\njruby-puppet.max-active-instances: 7\r\nJAVA_ARGS: -Xms4096m -Xmx4096m -XX:ReservedCodeCacheSize=1024m\r\n# Hiera for the openvox_server class.\r\n# For puppet:\r\nopenvox_server::max_active_instances: 2\r\n"]
[21.41, "o", "openvox_server::heap_mb: 1536\r\nopenvox_server::reserved_code_cache_mb: 512\r\n# For compiler01:\r\n"]
[21.41, "o", "openvox_server::max_active_instances: 7\r\nopenvox_server::heap_mb: 4096\r\nopenvox_server::reserved_code_cache_mb: 1024\r\nFinished: plan openvox_tune::tune in 8.11 sec\r\n"]
