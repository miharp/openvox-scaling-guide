[13.951, "o", "node default {\r\n  include role::agent\r\n}\r\n--\r\nnode 'puppet.example.com' {\r\n  include role::primary\r\n}\r\n--\r\nnode /^compiler\\d+\\.example\\.com$/ {\r\n  include role::compiler\r\n}\r\n"]
