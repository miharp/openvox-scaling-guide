[23.297, "o", "---\r\n# A compiler, not a CA: ovadm enrolled it against the primary's CA with its\r\n# own CA switched off, and the module keeps it that way.\r\nopenvox_server::ca: false\r\nopenvox_server::ca_server: 'puppet.example.com'\r\n"]
